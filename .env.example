# Copy this file to .env and fill in your key. NEVER commit .env.
# Any OpenAI-compatible provider works: change these three values to switch.

LLM_API_KEY=your-key-here

# Groq example
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Gemini example (check the provider docs for the current base URL and model name)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=<a Gemini Flash model name from AI Studio>

# Safety cap on the agent loop
MAX_AGENT_STEPS=12